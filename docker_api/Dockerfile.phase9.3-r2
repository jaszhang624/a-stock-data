FROM a-stock-data-api:281fc69-phase9-2-r2

# Copy new source code (overwrites old)
COPY src/ ./src/

# Install duckdb from local wheel (keep PEP 427 filename)
COPY deploy/artifacts/phase9.3-r2/wheels/duckdb-1.1.3-cp311-cp311-manylinux_2_17_x86_64.manylinux2014_x86_64.whl /tmp/
RUN pip install --user --no-index /tmp/duckdb-1.1.3-cp311-cp311-manylinux_2_17_x86_64.manylinux2014_x86_64.whl

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/live')" || exit 1

CMD ["uvicorn", "astock_api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
